{
  "name": "tibeb",
  "version": "0.2.0",
  "description": "Tibeb: one window for making short videos (projects, library, create, edit, hand-off)",
  "private": true,
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run build && electron .",
    "shots": "npm run build && electron . --shots=docs/app",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "tsc -p tsconfig.main.json && node --test dist/main/store.test.js dist/main/agents.test.js",
    "setup": "./scripts/install.sh"
  },
  "dependencies": {
    "@remotion/fonts": "^4.0.545",
    "@remotion/player": "^4.0.545",
    "@remotion/zod-types": "^4.0.545",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.545",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
